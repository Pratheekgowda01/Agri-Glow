<mjml>
  <mj-head>
    <mj-title>Payment Received - ₹{{amount}}</mj-title>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .green-button {
        background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
      }
      .payment-success {
        background: linear-gradient(135deg, #2e7d32 0%, #388e3c 100%);
        color: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
      }
      .amount-highlight {
        font-size: 36px;
        font-weight: 700;
        color: #ffffff;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8f9fa">
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-image src="https://via.placeholder.com/200x80/4CAF50/ffffff?text=Agri+Glow" alt="Agri Glow" width="200px" padding="40px 25px 25px" />
      </mj-column>
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="0 25px">
      <mj-column>
        <mj-text font-size="28px" color="#2e7d32" font-weight="600" line-height="1.3" padding="0 0 20px" align="center">
          💰 Payment Received!
        </mj-text>
        
        <mj-text font-size="16px" color="#666666" line-height="1.6" padding="0 0 25px">
          Hi {{farmerName}},<br><br>
          Great news! Your payment has been successfully processed and credited to your Agri Glow wallet.
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Payment Success Box -->
    <mj-section background-color="#ffffff" padding="0 25px">
      <mj-column css-class="payment-success" padding="25px">
        <mj-text font-size="18px" color="#ffffff" padding="0 0 10px" align="center">
          Amount Credited
        </mj-text>
        <mj-text css-class="amount-highlight" padding="0 0 15px" align="center">
          ₹{{amount}}
        </mj-text>
        <mj-text font-size="14px" color="#ffffff" padding="0" align="center">
          Transaction ID: {{transactionId}}<br>
          Date: {{paymentDate}}
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Payment Details -->
    <mj-section background-color="#ffffff" padding="0 25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="25px 0 15px">
          Payment Details
        </mj-text>
        
        <mj-table>
          <tr>
            <td style="padding: 10px 0; color: #666666; font-size: 14px;">Order Number:</td>
            <td style="padding: 10px 0; color: #333333; font-size: 14px; font-weight: 500;">{{orderId}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #666666; font-size: 14px;">Product:</td>
            <td style="padding: 10px 0; color: #333333; font-size: 14px; font-weight: 500;">{{productName}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #666666; font-size: 14px;">Buyer:</td>
            <td style="padding: 10px 0; color: #333333; font-size: 14px; font-weight: 500;">{{buyerName}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #666666; font-size: 14px;">Quantity:</td>
            <td style="padding: 10px 0; color: #333333; font-size: 14px; font-weight: 500;">{{quantity}} {{unit}}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #666666; font-size: 14px;">Payment Method:</td>
            <td style="padding: 10px 0; color: #333333; font-size: 14px; font-weight: 500;">{{paymentMethod}}</td>
          </tr>
          <tr style="border-top: 1px solid #e0e0e0;">
            <td style="padding: 15px 0 10px; color: #2e7d32; font-size: 16px; font-weight: 600;">Net Amount Received:</td>
            <td style="padding: 15px 0 10px; color: #2e7d32; font-size: 16px; font-weight: 700;">₹{{amount}}</td>
          </tr>
        </mj-table>
        
        {{#if platformFee}}
        <mj-text font-size="12px" color="#666666" padding="10px 0 0">
          *After deducting platform fee of ₹{{platformFee}} ({{platformFeePercent}}%)
        </mj-text>
        {{/if}}
      </mj-column>
    </mj-section>
    
    <!-- Wallet Balance -->
    <mj-section background-color="#f8f9fa" padding="25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="0 0 15px">
          💳 Wallet Update
        </mj-text>
        
        <mj-table>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Previous Balance:</td>
            <td style="padding: 8px 0; color: #333333; font-size: 14px; font-weight: 500;">₹{{previousBalance}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Amount Added:</td>
            <td style="padding: 8px 0; color: #2e7d32; font-size: 14px; font-weight: 600;">+₹{{amount}}</td>
          </tr>
          <tr style="border-top: 1px solid #ddd;">
            <td style="padding: 12px 0 8px; color: #333333; font-size: 16px; font-weight: 600;">New Balance:</td>
            <td style="padding: 12px 0 8px; color: #2e7d32; font-size: 18px; font-weight: 700;">₹{{newBalance}}</td>
          </tr>
        </mj-table>
        
        <mj-text font-size="14px" color="#4CAF50" padding="15px 0 0">
          💡 You can withdraw your earnings anytime from your wallet to your bank account.
        </mj-text>
        
        <mj-button css-class="green-button" color="#ffffff" font-size="14px" href="{{walletUrl}}" padding="15px 0 0">
          View Wallet
        </mj-button>
      </mj-column>
    </mj-section>
    
    <!-- Monthly Summary -->
    <mj-section background-color="#ffffff" padding="25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="0 0 15px">
          📊 This Month's Summary
        </mj-text>
        
        <mj-table>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Total Orders:</td>
            <td style="padding: 8px 0; color: #2e7d32; font-size: 14px; font-weight: 600;">{{monthlyOrders}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Total Earnings:</td>
            <td style="padding: 8px 0; color: #2e7d32; font-size: 14px; font-weight: 600;">₹{{monthlyEarnings}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Customer Rating:</td>
            <td style="padding: 8px 0; color: #2e7d32; font-size: 14px; font-weight: 600;">⭐ {{averageRating}}/5</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #666666; font-size: 14px;">Products Sold:</td>
            <td style="padding: 8px 0; color: #2e7d32; font-size: 14px; font-weight: 600;">{{productsSold}} items</td>
          </tr>
        </mj-table>
        
        <mj-text font-size="14px" color="#666666" padding="15px 0 0">
          Keep up the excellent work! Your quality products and service are making a difference.
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Quick Actions -->
    <mj-section background-color="#f8f9fa" padding="25px">
      <mj-column>
        <mj-text font-size="16px" color="#333333" font-weight="500" padding="0 0 15px">
          Quick Actions
        </mj-text>
        
        <mj-button css-class="green-button" color="#ffffff" font-size="14px" href="{{withdrawUrl}}" padding="0 5px 10px 0" width="48%">
          Withdraw Funds
        </mj-button>
        
        <mj-button background-color="#2196F3" color="#ffffff" font-size="14px" href="{{dashboardUrl}}" padding="0 0 10px 5px" width="48%">
          View Dashboard
        </mj-button>
        
        <mj-button background-color="#FF9800" color="#ffffff" font-size="14px" href="{{addProductUrl}}" padding="10px 5px 0 0" width="48%">
          Add Products
        </mj-button>
        
        <mj-button background-color="#9C27B0" color="#ffffff" font-size="14px" href="{{reportsUrl}}" padding="10px 0 0 5px" width="48%">
          View Reports
        </mj-button>
      </mj-column>
    </mj-section>
    
    <!-- Footer -->
    <mj-section background-color="#ffffff" padding="25px">
      <mj-column>
        <mj-text font-size="12px" color="#666666" line-height="1.5" padding="0 0 15px">
          <strong>Need Help?</strong><br>
          • View transaction history in your dashboard<br>
          • Contact support for payment-related queries<br>
          • Check our withdrawal policies and timelines
        </mj-text>
        
        <mj-text align="center" font-size="12px" color="#999999" line-height="1.5" padding="15px 0 0">
          © {{year}} Agri Glow. All rights reserved.<br>
          Empowering farmers with direct sales and instant payments.
        </mj-text>
        
        <mj-text align="center" font-size="12px" color="#999999" padding="10px 0 0">
          <a href="{{walletUrl}}" style="color: #4CAF50; text-decoration: none;">Wallet</a> | 
          <a href="{{transactionUrl}}" style="color: #4CAF50; text-decoration: none;">Transaction Details</a> | 
          <a href="{{baseUrl}}/support" style="color: #999999; text-decoration: none;">Support</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>