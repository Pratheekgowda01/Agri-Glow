<mjml>
  <mj-head>
    <mj-title>Stock Alert - {{productName}}</mj-title>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .green-button {
        background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
      }
      .warning-box {
        border: 2px solid #ff9800;
        border-radius: 12px;
        background: linear-gradient(135deg, #fff3e0 0%, #ffeaa7 100%);
      }
      .out-of-stock-box {
        border: 2px solid #f44336;
        border-radius: 12px;
        background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
      }
      .urgent-text {
        color: #d32f2f;
        font-weight: 600;
      }
      .warning-text {
        color: #f57c00;
        font-weight: 600;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8f9fa">
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
  <mj-image src="https://raw.githubusercontent.com/Pratheekgowda01/Agri-Glow/main/agriglowlogo.jpg" alt="Agri Glow Logo" width="150px" />
      </mj-column>
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="0 25px">
      <mj-column>
        {{#if (eq alertType 'out_of_stock')}}
        <mj-text font-size="28px" color="#d32f2f" font-weight="600" line-height="1.3" padding="0 0 20px" align="center">
          ⚠️ Product Out of Stock
        </mj-text>
        {{else}}
        <mj-text font-size="28px" color="#f57c00" font-weight="600" line-height="1.3" padding="0 0 20px" align="center">
          📉 Low Stock Alert
        </mj-text>
        {{/if}}
        
        <mj-text font-size="16px" color="#666666" line-height="1.6" padding="0 0 25px">
          Hi {{farmerName}},<br><br>
          {{#if (eq alertType 'out_of_stock')}}
          Your product <strong>"{{productName}}"</strong> is now completely out of stock and has been automatically removed from buyer listings.
          {{else}}
          Your product <strong>"{{productName}}"</strong> is running low on stock. Only {{currentStock}} {{unit}} remaining!
          {{/if}}
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Alert Box -->
    <mj-section background-color="#ffffff" padding="0 25px">
      {{#if (eq alertType 'out_of_stock')}}
      <mj-column css-class="out-of-stock-box" padding="25px">
        <mj-text font-size="20px" color="#d32f2f" font-weight="600" padding="0 0 15px" align="center">
          🚫 OUT OF STOCK
        </mj-text>
        
        <mj-table>
          <tr>
            <td style="padding: 8px 0; color: #d32f2f; font-size: 14px; font-weight: 500;">Product:</td>
            <td style="padding: 8px 0; color: #b71c1c; font-size: 14px; font-weight: 600;">{{productName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #d32f2f; font-size: 14px; font-weight: 500;">Current Stock:</td>
            <td style="padding: 8px 0; color: #b71c1c; font-size: 16px; font-weight: 700;">0 {{unit}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #d32f2f; font-size: 14px; font-weight: 500;">Status:</td>
            <td style="padding: 8px 0; color: #b71c1c; font-size: 14px; font-weight: 600;">Unavailable to buyers</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #d32f2f; font-size: 14px; font-weight: 500;">Last Sale:</td>
            <td style="padding: 8px 0; color: #b71c1c; font-size: 14px; font-weight: 600;">{{lastSaleDate}}</td>
          </tr>
        </mj-table>
      </mj-column>
      {{else}}
      <mj-column css-class="warning-box" padding="25px">
        <mj-text font-size="20px" color="#f57c00" font-weight="600" padding="0 0 15px" align="center">
          ⚡ LOW STOCK WARNING
        </mj-text>
        
        <mj-table>
          <tr>
            <td style="padding: 8px 0; color: #f57c00; font-size: 14px; font-weight: 500;">Product:</td>
            <td style="padding: 8px 0; color: #e65100; font-size: 14px; font-weight: 600;">{{productName}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #f57c00; font-size: 14px; font-weight: 500;">Remaining Stock:</td>
            <td style="padding: 8px 0; color: #e65100; font-size: 16px; font-weight: 700;">{{currentStock}} {{unit}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #f57c00; font-size: 14px; font-weight: 500;">Minimum Threshold:</td>
            <td style="padding: 8px 0; color: #e65100; font-size: 14px; font-weight: 600;">{{minThreshold}} {{unit}}</td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #f57c00; font-size: 14px; font-weight: 500;">Daily Sales Rate:</td>
            <td style="padding: 8px 0; color: #e65100; font-size: 14px; font-weight: 600;">~{{dailySalesRate}} {{unit}}/day</td>
          </tr>
        </mj-table>
        
        <mj-text font-size="14px" color="#e65100" padding="15px 0 0" align="center">
          ⏰ At current sales rate, you'll run out in approximately {{daysUntilEmpty}} days
        </mj-text>
      </mj-column>
      {{/if}}
    </mj-section>
    
    <!-- Impact Information -->
    <mj-section background-color="#ffffff" padding="0 25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="25px 0 15px">
          📊 Impact on Your Sales
        </mj-text>
        
        {{#if (eq alertType 'out_of_stock')}}
        <mj-text font-size="14px" color="#666666" line-height="1.6" padding="0 0 15px">
          • Your product is no longer visible to buyers<br>
          • You're missing out on potential sales<br>
          • Your product ranking may be affected<br>
          {{#if missedOrders}}
          • <span style="color: #d32f2f;">{{missedOrders}} potential orders lost in the last 24 hours</span>
          {{/if}}
        </mj-text>
        {{else}}
        <mj-text font-size="14px" color="#666666" line-height="1.6" padding="0 0 15px">
          • Product still available but stock is critically low<br>
          • Risk of disappointing buyers with cancellations<br>
          • May affect your seller rating if you can't fulfill orders<br>
          • High demand product - restock quickly to maximize earnings
        </mj-text>
        {{/if}}
        
        <mj-text font-size="14px" color="#4CAF50" padding="0 0 15px">
          <strong>Recent Performance:</strong><br>
          • Total sales this month: {{monthlySales}} {{unit}}<br>
          • Revenue generated: ₹{{monthlyRevenue}}<br>
          • Customer rating: ⭐ {{productRating}}/5 ({{totalReviews}} reviews)
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Action Required -->
    <mj-section background-color="#f8f9fa" padding="25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="0 0 15px">
          🎯 Action Required
        </mj-text>
        
        {{#if (eq alertType 'out_of_stock')}}
        <mj-text font-size="14px" color="#666666" line-height="1.8" padding="0 0 20px">
          <strong>To restore your product listing:</strong><br>
          1. Update your stock quantity in the dashboard<br>
          2. Verify product details and pricing<br>
          3. Ensure product images are current<br>
          4. Activate the product for selling<br>
          5. Your product will be instantly visible to buyers again
        </mj-text>
        
        <mj-button css-class="green-button" color="#ffffff" font-size="16px" font-weight="500" href="{{restockUrl}}" padding="0 0 15px">
          Restock Now
        </mj-button>
        {{else}}
        <mj-text font-size="14px" color="#666666" line-height="1.8" padding="0 0 20px">
          <strong>Recommended actions:</strong><br>
          1. <strong>Restock immediately</strong> - Add more inventory<br>
          2. <strong>Adjust pricing</strong> - Consider increasing price to slow demand<br>
          3. <strong>Update minimum order</strong> - Increase minimum quantity per order<br>
          4. <strong>Set delivery date</strong> - Schedule when fresh stock will be available<br>
          5. <strong>Notify buyers</strong> - Send update about restocking timeline
        </mj-text>
        
        <mj-button css-class="green-button" color="#ffffff" font-size="16px" font-weight="500" href="{{restockUrl}}" padding="0 5px 15px 0" width="48%">
          Add Stock
        </mj-button>
        
        <mj-button background-color="#FF9800" color="#ffffff" font-size="16px" href="{{manageUrl}}" padding="0 0 15px 5px" width="48%">
          Manage Product
        </mj-button>
        {{/if}}
        
        <mj-text font-size="12px" color="#666666" padding="10px 0 0">
          💡 <strong>Pro Tip:</strong> Set up automatic stock alerts to get notified before running out completely.
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Alternative Suggestions -->
    <mj-section background-color="#ffffff" padding="25px">
      <mj-column>
        <mj-text font-size="18px" color="#333333" font-weight="500" padding="0 0 15px">
          💡 Smart Suggestions
        </mj-text>
        
        <mj-text font-size="14px" color="#666666" line-height="1.6" padding="0 0 15px">
          {{#if (eq alertType 'out_of_stock')}}
          <strong>While restocking:</strong><br>
          • Add similar products from your farm<br>
          • Promote other available items<br>
          • Plan seasonal product rotation<br>
          • Consider pre-orders for next harvest
          {{else}}
          <strong>Inventory management tips:</strong><br>
          • Enable automatic reorder notifications<br>
          • Set up supplier contacts for quick restocking<br>
          • Consider offering pre-orders for popular items<br>
          • Bundle with other products to manage stock better
          {{/if}}
        </mj-text>
        
        {{#if similarProducts}}
        <mj-text font-size="14px" color="#4CAF50" padding="0 0 15px">
          <strong>Promote these available products:</strong><br>
          {{#each similarProducts}}
          • {{this.name}} ({{this.stock}} {{this.unit}} available)<br>
          {{/each}}
        </mj-text>
        {{/if}}
        
        <mj-button background-color="#2196F3" color="#ffffff" font-size="14px" href="{{addProductUrl}}" padding="10px 5px 0 0" width="48%">
          Add New Product
        </mj-button>
        
        <mj-button background-color="#9C27B0" color="#ffffff" font-size="14px" href="{{inventoryUrl}}" padding="10px 0 0 5px" width="48%">
          Inventory Manager
        </mj-button>
      </mj-column>
    </mj-section>
    
    <!-- Footer -->
    <mj-section background-color="#f8f9fa" padding="25px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#999999" line-height="1.5">
          © {{year}} Agri Glow. All rights reserved.<br>
          Helping farmers maximize their sales potential.
        </mj-text>
        
        <mj-text align="center" font-size="12px" color="#999999" padding="10px 0 0">
          <a href="{{productUrl}}" style="color: #4CAF50; text-decoration: none;">View Product</a> | 
          <a href="{{dashboardUrl}}" style="color: #4CAF50; text-decoration: none;">Dashboard</a> | 
          <a href="{{inventoryUrl}}" style="color: #4CAF50; text-decoration: none;">Manage Inventory</a> | 
          <a href="{{baseUrl}}/support" style="color: #999999; text-decoration: none;">Support</a>
        </mj-text>
        
        <mj-text align="center" font-size="10px" color="#cccccc" padding="15px 0 0">
          To stop receiving stock alerts, <a href="{{unsubscribeUrl}}" style="color: #cccccc;">click here</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>