<mjml>
  <mj-head>
    <mj-title>Agri Glow Order Invoice</mj-title>
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600" />
    <mj-attributes>
      <mj-all font-family="Poppins, Arial" />
      <mj-text font-weight="400" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Header -->
    <mj-section background-color="#00CC99" padding="20px 0">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/Pratheekgowda01/Agri-Glow/main/agriglowlogo.jpg" alt="Agri Glow Logo" width="150px" />
      </mj-column>
    </mj-section>

    <!-- Invoice Details -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column width="50%">
        <mj-text font-size="20px" font-weight="600" color="#333333">
          Invoice Details
        </mj-text>
        <mj-text font-size="14px" color="#666666">
          <strong>Invoice No:</strong> {{invoiceNumber}}<br/>
          <strong>Order ID:</strong> {{orderId}}<br/>
          <strong>Order Date:</strong> {{orderDate}}<br/>
          <strong>Payment Date:</strong> {{paymentDate}}
        </mj-text>
      </mj-column>
      <mj-column width="50%">
        <mj-text font-size="20px" font-weight="600" color="#333333">
          Payment Status
        </mj-text>
        <mj-text font-size="14px" color="#666666">
          <strong>Status:</strong> <span style="color: #00CC99;">{{paymentStatus}}</span><br/>
          <strong>Method:</strong> {{paymentMethod}}<br/>
          <strong>Transaction ID:</strong> {{transactionId}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Billing Details -->
    <mj-section background-color="#f8f9fa" padding="20px">
      <mj-column width="50%">
        <mj-text font-size="16px" font-weight="600" color="#333333">
          Bill To:
        </mj-text>
        <mj-text font-size="14px" color="#666666">
          {{buyerName}}<br/>
          {{buyerPhone}}<br/>
          {{buyerEmail}}<br/>
          {{buyerAddress}}
        </mj-text>
      </mj-column>
      <mj-column width="50%">
        <mj-text font-size="16px" font-weight="600" color="#333333">
          Sold By:
        </mj-text>
        <mj-text font-size="14px" color="#666666">
          {{farmerName}}<br/>
          {{farmerPhone}}<br/>
          {{farmerEmail}}<br/>
          {{farmerAddress}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Items Table -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#333333" padding-bottom="10px">
          Order Items
        </mj-text>
        
        <!-- Table Header -->
        <mj-table>
          <tr style="background-color: #f8f9fa; border-bottom: 1px solid #dee2e6;">
            <td style="padding: 10px; font-weight: 600;">Item</td>
            <td style="padding: 10px; font-weight: 600; text-align: center;">Qty</td>
            <td style="padding: 10px; font-weight: 600; text-align: right;">Unit Price</td>
            <td style="padding: 10px; font-weight: 600; text-align: right;">Total</td>
          </tr>
          {{#each items}}
          <tr style="border-bottom: 1px solid #e9ecef;">
            <td style="padding: 10px;">{{name}}</td>
            <td style="padding: 10px; text-align: center;">{{quantity}} {{unit}}</td>
            <td style="padding: 10px; text-align: right;">₹{{price}}</td>
            <td style="padding: 10px; text-align: right;">₹{{total}}</td>
          </tr>
          {{/each}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Total Section -->
    <mj-section background-color="#ffffff" padding="0 20px 30px 20px">
      <mj-column>
        <mj-table>
          <tr>
            <td style="padding: 5px 10px; text-align: right; width: 70%;">
              <strong>Subtotal:</strong>
            </td>
            <td style="padding: 5px 10px; text-align: right;">
              <strong>₹{{subtotal}}</strong>
            </td>
          </tr>
          <tr>
            <td style="padding: 5px 10px; text-align: right;">
              <strong>Tax (GST 18%):</strong>
            </td>
            <td style="padding: 5px 10px; text-align: right;">
              <strong>₹{{tax}}</strong>
            </td>
          </tr>
          <tr style="background-color: #00CC99; color: white;">
            <td style="padding: 10px; text-align: right; font-size: 18px;">
              <strong>Total Amount:</strong>
            </td>
            <td style="padding: 10px; text-align: right; font-size: 18px;">
              <strong>₹{{total}}</strong>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Thank You Section -->
    <mj-section background-color="#f8f9fa" padding="20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#00CC99" align="center">
          Thank you for your order!
        </mj-text>
        <mj-text font-size="14px" color="#666666" align="center">
          Your fresh produce will be delivered within 2-3 business days.
        </mj-text>
        <mj-text font-size="12px" color="#999999" align="center" padding-top="10px">
          For any queries, contact us at support@agriglow.com
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="12px" color="#666666" align="center">
          &copy; 2025 Agri Glow. All rights reserved.<br/>
          This is a system-generated invoice.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>