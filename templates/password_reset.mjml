<mjml>
  <mj-head>
    <mj-title>Reset Your Agri Glow Password</mj-title>
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Poppins, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .primary-button {
        background: linear-gradient(135deg, #00c08b 0%, #009f72 100%);
        border-radius: 30px;
      }
      .code-box {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 6px;
        color: #009f72;
        background-color: #e6fff5;
        padding: 16px 24px;
        border-radius: 16px;
        display: inline-block;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-section padding="30px 0 0">
      <mj-column>
  <mj-image src="https://raw.githubusercontent.com/Pratheekgowda01/Agri-Glow/main/agriglowlogo.jpg" alt="Agri Glow Logo" width="150px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 32px 32px" border-radius="24px">
      <mj-column>
        <mj-text font-size="26px" color="#101828" font-weight="600" padding="32px 0 12px">
          Reset your password, {{name}}
        </mj-text>
        <mj-text font-size="16px" color="#475467" line-height="1.6" padding="0 0 20px">
          We received a request to reset the password for your Agri Glow account. Use the one-time code below to proceed. This code will expire in {{expiresIn}} minutes.
        </mj-text>
        <mj-text align="center" padding="0 0 24px">
          <span class="code-box">{{otp}}</span>
        </mj-text>
        <mj-button css-class="primary-button" color="#ffffff" font-size="16px" font-weight="600" href="{{resetUrl}}" padding="0 0 24px">
          Reset password
        </mj-button>
        <mj-text font-size="14px" color="#475467" line-height="1.6" padding="0 0 16px">
          If you did not request this change, please secure your account immediately and contact our support team so we can help safeguard your access.
        </mj-text>
        <mj-text font-size="14px" color="#101828" font-weight="600" padding="0 0 4px">
          Need help?
        </mj-text>
        <mj-text font-size="14px" color="#475467" line-height="1.6">
          Email support at <a href="mailto:support@agriglow.com" style="color:#00c08b; text-decoration:none;">support@agriglow.com</a>{{#if supportPhone}} or call {{supportPhone}}{{/if}}.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f4f6f8" padding="24px 0 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#98a2b3" line-height="1.6">
          © {{year}} Agri Glow. All rights reserved.<br />
          You received this email because a password reset was requested for your account.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>